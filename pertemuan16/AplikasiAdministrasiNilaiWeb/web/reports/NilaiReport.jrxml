<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="NilaiReport" pageWidth="595" pageHeight="842" 
              whenNoDataType="AllSectionsNoDetail" columnWidth="555" 
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <queryString>
        <![CDATA[SELECT * FROM nilai]]>
    </queryString>
    
    <field name="nim" class="java.lang.String"/>
    <field name="kodemk" class="java.lang.String"/>
    <field name="nilai" class="java.lang.Integer"/>
    
    <background>
        <band splitType="Stretch"/>
    </background>
    
    <title>
        <band height="60" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[UNIVERSITAS PAMULANG]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="false"/>
                </textElement>
                <text><![CDATA[LAPORAN NILAI MAHASISWA]]></text>
            </staticText>
        </band>
    </title>
    
    <columnHeader>
        <band height="25" splitType="Stretch">
            <staticText>
                <reportElement x="50" y="2" width="150" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[NIM]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="2" width="150" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[KODE MATAKULIAH]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="2" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[NILAI]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="22" splitType="Stretch">
            <textField>
                <reportElement x="50" y="2" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{nim}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="2" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{kodemk}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="2" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{nilai}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>